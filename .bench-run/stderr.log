fn wasm_for_package(package_name: &str) -> eyre::Result<PathBuf> {
    let target_dir = env::var_os("CARGO_TARGET_DIR")
        .map(PathBuf::from)
        .unwrap_or_else(|| {
            let mut executable = env::current_exe().expect("test executable path exists");
            while executable.file_name().is_some_and(|name| name != "target") {
                executable.pop();
            }
            executable
        });
    let path = target_dir
        .join("wasm32-unknown-unknown")
        .join("release")
        .join(format!("{}.wasm", package_name.replace('-', "_")));
    if !path.exists() {
        eyre::bail!(
            "WASM artifact missing at {}; run scripts/e2e-tests.sh",
            path.display()
        );
    }
    Ok(path)
}
