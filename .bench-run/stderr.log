    fn find_package(package_name: Option<&str>) -> Result<Package> {
        let current_dir = std::env::current_dir().wrap_err("cannot read test working directory")?;
        let metadata = MetadataCommand::new()
            .current_dir(&current_dir)
            .no_deps()
            .exec()
            .wrap_err("cannot read Cargo workspace metadata")?;
        let expected_name = match package_name {
            Some(name) => name.to_owned(),
            None => metadata
                .packages
                .iter()
                .find(|package| package.manifest_path.as_std_path() == current_dir.join("Cargo.toml"))
                .map(|package| package.name.to_string())
                .ok_or_else(|| eyre::eyre!("no package manifest found in {}", current_dir.display()))?,
        };
        metadata
            .packages
            .into_iter()
            .find(|package| package.name == expected_name)
            .ok_or_else(|| eyre::eyre!("Cargo package `{expected_name}` not found"))
    }
}
